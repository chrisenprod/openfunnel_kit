# Install as /etc/openfunnel/landing-deploy.env, owned by root, mode 0600.
# Trusted shell configuration; do not put application/provider secrets here.

# GitHub repository to deploy, in owner/repository format.
DEPLOY_REPOSITORY=YOUR_GITHUB_USER/YOUR_REPOSITORY

# Branch allowed for deployment.
DEPLOY_BRANCH=main

# Public HTTPS origin of the landing page.
LANDING_ORIGIN=https://landing.example.com

# Web release directory; the current symlink points to the active release.
LANDING_ROOT=/var/www/openfunnel

# Private deployment state and checkout directory, outside the public web root.
LANDING_STATE_ROOT=/srv/openfunnel-landing

# Build image matching the tested Node version; pin it by digest.
LANDING_NODE_IMAGE=node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

# Docker memory limit for the landing build (for example, 1g).
LANDING_BUILD_MEMORY=1g

# Docker CPU limit for the landing build.
LANDING_BUILD_CPUS=1
