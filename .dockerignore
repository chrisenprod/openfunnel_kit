# Only production inputs enter the builder, including intermediate layers.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!vite.config.js
!LICENSE
!NOTICE
!LICENSING.md
!backend/
backend/**
!backend/*.js
!backend/migrations/
backend/migrations/**
!backend/migrations/*.sql
!shared/
shared/**
!shared/*.js
!frontend/
frontend/**
!frontend/index.html
!frontend/src/
frontend/src/**
!frontend/src/*.js
!frontend/src/*.jsx
!frontend/src/*.css
!landing/
landing/**
!landing/LICENSE
!landing/brand.css
!landing/assets/
landing/assets/**
!landing/assets/images/
landing/assets/images/**
!landing/assets/images/openfunnel-mark.webp
!deploy/
deploy/**
!deploy/app.nginx.conf
