# Copy to .env.local for npm run dev:backend, or .env for npm start.
# Keep development and production databases and secrets separate.
# Reiniciar la API tras cambiar valores. No versionar .env ni exponer secretos con VITE_*.
# En self-hosted, cada campo Zernio/LLM definido aquí tiene prioridad y queda bloqueado en la interfaz.
# En cloud se ignoran las claves, URL y modelo globales de proveedores: cada cuenta configura los suyos en la interfaz.
# Guardar conexiones desde la interfaz requiere PROVIDER_ENCRYPTION_KEY en el servidor.

# Puerto de la API (3001 por defecto); el proxy de Vite debe apuntar al mismo puerto.
PORT=3001

# Dirección de escucha: 127.0.0.1 para desarrollo; 0.0.0.0 dentro de Docker.
HOST=127.0.0.1

# Archivo SQLite en modo self-hosted. En cloud, la API usa CLOUD_DATA_DIR/control.sqlite y workspaces/.
DATABASE_PATH=backend/data/app.sqlite

# Origen exacto de la interfaz, sin rutas: protocolo, dominio y puerto. También se usa en enlaces de correo.
APP_ORIGIN=http://localhost:5173

# Usuario de acceso en self-hosted. No se usa en cloud: allí cada persona se registra con su correo.
admin_user=admin

# Contraseña de acceso en self-hosted: 12–128 caracteres. No se usa en cloud.
admin_pass=

# Secreto de sesiones, mínimo 32 caracteres. Obligatorio en cloud; en self-hosted se genera en SQLite si falta. Mantenerlo estable.
# BETTER_AUTH_SECRET=

# Solo self-hosted: clave de Zernio. Vacía permite configurarla en Canales → Conexión Zernio. Cloud ignora esta variable.
ZERNIO_API_KEY=

# Origen HTTPS público de la app para callbacks y webhooks de Zernio. No es la URL de la API de Zernio.
PUBLIC_BASE_URL=

# Solo self-hosted: secreto de firma de webhooks, 32+ caracteres. Cloud genera uno por espacio desde la clave maestra.
ZERNIO_WEBHOOK_SECRET=

# Solo self-hosted: URL base compatible con OpenAI; Azure usa el endpoint terminado en /openai/v1/. Cloud la pide en la interfaz.
LLM_BASE_URL=

# Solo self-hosted: clave del proveedor de IA. Vacía permite guardarla en Agentes IA → Conexión IA. Cloud ignora esta variable.
LLM_API_KEY=

# Solo self-hosted: identificador del modelo o nombre del deployment de Azure. Vacío permite configurarlo en la interfaz.
LLM_MODEL=

# self-hosted: acceso único con admin_user/admin_pass. cloud: registro, correo verificado y espacio independiente por cuenta.
APP_MODE=self-hosted

# Directorio de datos cloud: control.sqlite para cuentas y workspaces/ para sus bases. Respaldar el directorio completo.
CLOUD_DATA_DIR=backend/data/cloud

# Correo del dueño de la instancia: obtiene superadmin al registrarse y verificarlo. No cambiar tras crear al dueño.
CLOUD_OWNER_EMAIL=

# Límite de registros cloud, incluidos los aún no verificados (1–500; predeterminado: 100).
CLOUD_MAX_ACCOUNTS=100

# Clave de Resend para verificación y recuperación de cuentas cloud. Se conserva en el servidor, no en la interfaz.
RESEND_API_KEY=

# Remitente de Resend: Nombre <noreply@tu-dominio-verificado>. Debe usar un dominio verificado en tu cuenta.
RESEND_FROM=

# Clave maestra para cifrar conexiones guardadas desde la interfaz; obligatoria en cloud. Exactamente 64 caracteres hexadecimales.
# Respaldarla fuera de SQLite; no regenerarla sin migrar las conexiones existentes.
# Generar una vez: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=

# Hosts permitidos para URLs de IA guardadas desde la interfaz, separados por comas; admite *.dominio. Exige HTTPS/443 y DNS público.
LLM_ALLOWED_HOSTS=api.openai.com,openrouter.ai,*.openai.azure.com,*.services.ai.azure.com

# Token de organización de Polar. Solo backend; nunca VITE_*.
POLAR_TOKEN=

# Facturación cloud opcional. true exige suscripción pagada y créditos para usar IA/tools.
# Preparar productos, créditos y webhook antes de activarla; no afecta lectura ni gestión manual.
BILLING_ENABLED=false

# Exempt the verified instance owner from subscription and credit limits; keep usage history.
BILLING_OWNER_EXEMPT=false



# production para cobros reales; sandbox para pruebas. Cada entorno tiene planes y saldos separados.
POLAR_SERVER=production


# Secreto del endpoint Raw /api/billing/polar/webhook, copiado del panel de Polar.
# Eventos: order.paid, order.refunded y subscription.updated.
POLAR_WEBHOOK_SECRET=
