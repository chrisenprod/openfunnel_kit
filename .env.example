PORT=3001
# Loopback por defecto. Dentro de Docker se configura 0.0.0.0 explícitamente.
HOST=127.0.0.1
DATABASE_PATH=backend/data/app.sqlite

# Único origen de la app. Cambiar también al usar preview o un dominio con HTTPS.
APP_ORIGIN=http://localhost:5173
# Acceso single user. Contraseña de 12–128 caracteres; sin valor predeterminado.
admin_user=admin
admin_pass=
# Opcional: secreto de al menos 32 caracteres. Si falta, se genera y persiste en SQLite.
# BETTER_AUTH_SECRET=

# Integraciones opcionales: solo backend, nunca VITE_*.
ZERNIO_API_KEY=
# Para recibir mensajes reales: origen HTTPS de la app y secreto de 32+ caracteres.
PUBLIC_BASE_URL=
ZERNIO_WEBHOOK_SECRET=
# SDK OpenAI / Chat Completions. Azure: endpoint v1 y nombre del deployment.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
