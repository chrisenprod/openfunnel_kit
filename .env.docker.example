# Copiar a .env.docker y usar siempre --env-file .env.docker.
# Variables separadas de .env para no reutilizar la instalación de desarrollo.
DOCKER_HTTP_PORT=8080
DOCKER_APP_ORIGIN=http://localhost:8080
DOCKER_ADMIN_USER=admin
# Obligatoria: entre 12 y 128 caracteres. Usar comillas simples si contiene $ o #.
DOCKER_ADMIN_PASS=
# Opcional: si falta, se genera y persiste en el volumen SQLite.
DOCKER_BETTER_AUTH_SECRET=

# Dejar vacías para pruebas locales sin servicios externos.
DOCKER_ZERNIO_API_KEY=
DOCKER_PUBLIC_BASE_URL=
DOCKER_ZERNIO_WEBHOOK_SECRET=
DOCKER_LLM_BASE_URL=
DOCKER_LLM_API_KEY=
DOCKER_LLM_MODEL=
