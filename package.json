{
  "name": "openfunnel-kit",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "test": "node --test tests/*.test.js",
    "test:docker": "node scripts/test-docker.mjs",
    "openspec": "OPENSPEC_TELEMETRY=0 openspec",
    "spec:validate": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "dev": "vite",
    "dev:landing": "vite --config landing/vite.config.js",
    "build:landing": "vite build --config landing/vite.config.js",
    "preview:landing": "vite preview --config landing/vite.config.js",
    "dev:backend": "node --watch --env-file-if-exists=.env backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env backend/server.js"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
